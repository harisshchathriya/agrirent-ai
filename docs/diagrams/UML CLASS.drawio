                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass AuthRouter {\n  +register()\n  +login()\n  +read_users_me()\n}\n\nclass EquipmentRouter {\n  +add_equipment()\n  +read_all_equipment()\n  +read_equipment()\n  +edit_equipment()\n  +remove_equipment()\n}\n\nclass BookingRouter {\n  +create_booking()\n  +get_bookings()\n  +get_booking()\n  +update_booking_status()\n  +delete_booking()\n  +get_owner_bookings()\n  +approve_booking()\n  +reject_booking()\n  +complete_booking()\n  +cancel_booking()\n}\n\nclass EquipmentRelationsRouter {\n  +get_images()\n  +add_image()\n  +get_reviews()\n  +add_review()\n}\n\nclass AuthService {\n  +get_user_by_email()\n  +register_user()\n  +login_user()\n}\n\nclass EquipmentService {\n  +create_equipment()\n  +get_all_equipment()\n  +get_equipment_by_id()\n  +update_equipment()\n  +delete_equipment()\n}\n\nclass BookingService {\n  +create_booking()\n  +get_all_bookings()\n  +get_booking_by_id()\n  +update_booking_status()\n  +delete_booking()\n  +approve_booking()\n  +reject_booking()\n  +complete_booking()\n  +cancel_booking()\n}\n\nclass EquipmentRelationsService {\n  +get_equipment_or_404()\n  +get_images()\n  +add_image()\n  +get_reviews()\n  +add_review()\n}\n\nclass UserCreate\nclass UserResponse\nclass Token\nclass EquipmentCreate\nclass EquipmentUpdate\nclass EquipmentResponse\nclass BookingCreate\nclass BookingStatusUpdate\nclass BookingUpdate\nclass BookingResponse\nclass EquipmentImageCreate\nclass ReviewCreate\n\nclass User {\n  +UUID id\n  +String name\n  +String email\n  +String phone\n  +UserRole role\n  +DateTime created_at\n}\n\nclass UserRole {\n  &lt;&lt;enumeration&gt;&gt;\n  ADMIN\n  FARMER\n  OWNER\n}\n\nclass Equipment {\n  +UUID id\n  +UUID owner_id\n  +String name\n  +String category\n  +Numeric price_per_day\n  +String location\n  +Boolean availability\n  +String image_url\n  +DateTime created_at\n}\n\nclass Booking {\n  +UUID id\n  +UUID equipment_id\n  +UUID renter_id\n  +Date start_date\n  +Date end_date\n  +Numeric total_price\n  +BookingStatus status\n  +DateTime created_at\n}\n\nclass BookingStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  PENDING\n  APPROVED\n  REJECTED\n  COMPLETED\n  CANCELLED\n}\n\nclass EquipmentImage {\n  +UUID id\n  +UUID equipment_id\n  +String image_url\n  +DateTime created_at\n}\n\nclass Review {\n  +UUID id\n  +UUID user_id\n  +UUID equipment_id\n  +Integer rating\n  +Text comment\n  +DateTime created_at\n}\n\nclass PostgreSQL {\n  users\n  equipment\n  bookings\n  equipment_images\n  reviews\n}\n\nAuthRouter --&gt; AuthService\nEquipmentRouter --&gt; EquipmentService\nBookingRouter --&gt; BookingService\nEquipmentRelationsRouter --&gt; EquipmentRelationsService\n\nAuthService --&gt; User\nEquipmentService --&gt; Equipment\nBookingService --&gt; Booking\nEquipmentRelationsService --&gt; EquipmentImage\nEquipmentRelationsService --&gt; Review\n\nAuthService --&gt; UserCreate\nAuthService --&gt; UserResponse\nAuthService --&gt; Token\nEquipmentService --&gt; EquipmentCreate\nEquipmentService --&gt; EquipmentUpdate\nEquipmentService --&gt; EquipmentResponse\nBookingService --&gt; BookingCreate\nBookingService --&gt; BookingStatusUpdate\nBookingService --&gt; BookingUpdate\nBookingService --&gt; BookingResponse\nEquipmentRelationsService --&gt; EquipmentImageCreate\nEquipmentRelationsService --&gt; ReviewCreate\n\nUser \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Equipment\nUser \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Booking\nUser \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Review\nEquipment \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Booking\nEquipment \&quot;1\&quot; --&gt; \&quot;0..*\&quot; EquipmentImage\nEquipment \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Review\nBooking \&quot;*\&quot; --&gt; \&quot;1\&quot; User\nBooking \&quot;*\&quot; --&gt; \&quot;1\&quot; Equipment\nEquipmentImage \&quot;*\&quot; --&gt; \&quot;1\&quot; Equipment\nReview \&quot;*\&quot; --&gt; \&quot;1\&quot; User\nReview \&quot;*\&quot; --&gt; \&quot;1\&quot; Equipment\n\nUser --&gt; UserRole\nBooking --&gt; BookingStatus\nPostgreSQL --&gt; User\nPostgreSQL --&gt; Equipment\nPostgreSQL --&gt; Booking\nPostgreSQL --&gt; EquipmentImage\nPostgreSQL --&gt; Review\n\nnamespace API {\n  class AuthRouter\n  class EquipmentRouter\n  class BookingRouter\n  class EquipmentRelationsRouter\n}\n\nnamespace SERVICES {\n  class AuthService\n  class EquipmentService\n  class BookingService\n  class EquipmentRelationsService\n}\n\nnamespace SCHEMAS {\n  class UserCreate\n  class UserResponse\n  class Token\n  class EquipmentCreate\n  class EquipmentUpdate\n  class EquipmentResponse\n  class BookingCreate\n  class BookingStatusUpdate\n  class BookingUpdate\n  class BookingResponse\n  class EquipmentImageCreate\n  class ReviewCreate\n}\n\nnamespace DOMAIN_MODELS {\n  class User\n  class UserRole\n  class Equipment\n  class Booking\n  class BookingStatus\n  class EquipmentImage\n  class Review\n}\n\nnamespace DATABASE {\n  class PostgreSQL\n}&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="stopmJHP8Ss0qU7Bkjql-1">
