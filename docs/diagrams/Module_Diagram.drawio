        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n  T[\&quot;AgriRent AI – Module Diagram&lt;br/&gt;&lt;small&gt;Review-II Software Module Structure&lt;/small&gt;\&quot;]\n\n  subgraph F[\&quot;FRONTEND&lt;br/&gt;&lt;small&gt;React + Vite + Tailwind CSS + Axios + React Router&lt;/small&gt;\&quot;]\n    AUTH[\&quot;Authentication Module&lt;br/&gt;Login&lt;br/&gt;Registration\&quot;]\n    DASH[\&quot;Dashboard Module&lt;br/&gt;Farmer Dashboard&lt;br/&gt;Owner Dashboard\&quot;]\n    EQUIP[\&quot;Equipment Module&lt;br/&gt;Equipment List&lt;br/&gt;Equipment Details&lt;br/&gt;Equipment Management\&quot;]\n    BOOK[\&quot;Booking Module&lt;br/&gt;My Bookings&lt;br/&gt;Owner Bookings&lt;br/&gt;Booking Status\&quot;]\n    REL[\&quot;Equipment Relations Module&lt;br/&gt;Equipment Images&lt;br/&gt;Equipment Reviews\&quot;]\n    CLIENT[\&quot;API Client Module&lt;br/&gt;Axios&lt;br/&gt;JWT authentication&lt;br/&gt;API communication\&quot;]\n    AUTH --&gt; CLIENT\n    DASH --&gt; CLIENT\n    EQUIP --&gt; CLIENT\n    BOOK --&gt; CLIENT\n    REL --&gt; CLIENT\n  end\n\n  subgraph B[\&quot;BACKEND&lt;br/&gt;&lt;small&gt;FastAPI + Python&lt;/small&gt;\&quot;]\n    API[\&quot;API Layer&lt;br/&gt;Auth API&lt;br/&gt;Equipment API&lt;br/&gt;Booking API&lt;br/&gt;Equipment Relations API\&quot;]\n    SERVICES[\&quot;Service Layer&lt;br/&gt;Auth Service&lt;br/&gt;Equipment Service&lt;br/&gt;Booking Service&lt;br/&gt;Equipment Relations Service\&quot;]\n    SCHEMAS[\&quot;Schema Layer&lt;br/&gt;User Schemas&lt;br/&gt;Equipment Schemas&lt;br/&gt;Booking Schemas&lt;br/&gt;Equipment Image Schemas&lt;br/&gt;Review Schemas\&quot;]\n    MODELS[\&quot;Model Layer&lt;br/&gt;User&lt;br/&gt;Equipment&lt;br/&gt;Booking&lt;br/&gt;Equipment Image&lt;br/&gt;Review\&quot;]\n    CORE[\&quot;Core Layer&lt;br/&gt;Security&lt;br/&gt;Configuration&lt;br/&gt;Database Session\&quot;]\n\n    API --&gt; SERVICES\n    SERVICES --&gt; SCHEMAS\n    SERVICES --&gt; MODELS\n    CORE --&gt; SERVICES\n    CORE --&gt; MODELS\n  end\n\n  DB[\&quot;PostgreSQL Database&lt;br/&gt;users&lt;br/&gt;equipment&lt;br/&gt;bookings&lt;br/&gt;equipment_images&lt;br/&gt;reviews\&quot;]\n\n  CLIENT --&gt; API\n  AUTH --&gt; API\n  EQUIP --&gt; API\n  BOOK --&gt; API\n  REL --&gt; API\n\n  SERVICES --&gt; SCHEMAS\n  SERVICES --&gt; MODELS\n  MODELS --&gt; DB\n\n  AUTHAPI[\&quot;Auth API\&quot;] --&gt; AUTHS[\&quot;Auth Service\&quot;]\n  EQUIPAPI[\&quot;Equipment API\&quot;] --&gt; EQUIPS[\&quot;Equipment Service\&quot;]\n  BOOKAPI[\&quot;Booking API\&quot;] --&gt; BOOKS[\&quot;Booking Service\&quot;]\n  RELAPI[\&quot;Equipment Relations API\&quot;] --&gt; RELS[\&quot;Equipment Relations Service\&quot;]\n\n  AUTHS --&gt; USERS[\&quot;User Schemas\&quot;]\n  EQUIPS --&gt; EQUIPMENT_SCHEMA[\&quot;Equipment Schemas\&quot;]\n  BOOKS --&gt; BOOKING_SCHEMA[\&quot;Booking Schemas\&quot;]\n  RELS --&gt; IMAGE_SCHEMA[\&quot;Equipment Image Schemas\&quot;]\n  RELS --&gt; REVIEW_SCHEMA[\&quot;Review Schemas\&quot;]\n\n  AUTHS --&gt; USER_MODEL[\&quot;User\&quot;]\n  EQUIPS --&gt; EQUIPMENT_MODEL[\&quot;Equipment\&quot;]\n  BOOKS --&gt; BOOKING_MODEL[\&quot;Booking\&quot;]\n  BOOKS --&gt; EQUIPMENT_MODEL\n  RELS --&gt; IMAGE_MODEL[\&quot;Equipment Image\&quot;]\n  RELS --&gt; REVIEW_MODEL[\&quot;Review\&quot;]\n\n  T -.-&gt; F\n\n\n  class T heading\n  class AUTH,DASH,EQUIP,BOOK,REL,CLIENT,API,SERVICES,SCHEMAS,MODELS,CORE,AUTHAPI,EQUIPAPI,BOOKAPI,RELAPI,AUTHS,EQUIPS,BOOKS,RELS,USERS,EQUIPMENT_SCHEMA,BOOKING_SCHEMA,IMAGE_SCHEMA,REVIEW_SCHEMA,USER_MODEL,EQUIPMENT_MODEL,BOOKING_MODEL,IMAGE_MODEL,REVIEW_MODEL module\n  class DB database\n\n  style F fill:#fff,stroke:#1f4e8c,stroke-width:2px\n  style B fill:#fff,stroke:#1f4e8c,stroke-width:2px\n  linkStyle default stroke:#111,stroke-width:1px&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="okF3KTyx2wn_vJQ06C3E-1">
